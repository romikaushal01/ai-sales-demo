    return;
  }

  let sessionId =
    localStorage.getItem("ai_sales_chat_session");

  if (!sessionId) {

    sessionId = crypto.randomUUID();

    localStorage.setItem(
      "ai_sales_chat_session",
      sessionId
    );

  }

  /* =============================== */
  /* TOGGLE */
  /* =============================== */

  toggle.addEventListener("click", function () {

    windowEl.classList.toggle("open");

    if (windowEl.classList.contains("open")) {
      input.focus();
    }

  });

  /* =============================== */
  /* SIMPLE MESSAGE */
  /* =============================== */

  function addMessage(text, type) {

    const div =
      document.createElement("div");

    div.className =
      "ai-message " + type;

    div.textContent = text;

    messages.appendChild(div);

    messages.scrollTop =
      messages.scrollHeight;
  }

  /* =============================== */
  /* PRODUCT CARD */
  /* =============================== */

  function createProductCard(product) {

    const card =
      document.createElement("div");

    card.className =
      "ai-product-card";

    const image =
      document.createElement("img");

    image.src =
      product.image || "";

    image.alt =
      product.title || "Product";

    const title =
      document.createElement("h4");

    title.textContent =
      product.title || "";

    const brand =
      document.createElement("p");

    brand.className =
      "ai-product-brand";

    brand.textContent =
      product.vendor || "";

    const price =
      document.createElement("p");

    price.className =
      "ai-product-price";

    price.textContent =
      "$" + (product.price || "0");

    const link =
      document.createElement("a");

    link.href =
      product.url || "#";

    link.target =
      "_blank";

    link.rel =
      "noopener noreferrer";

    link.className =
      "ai-view-product";

    link.textContent =
      "View Product";

    card.appendChild(image);
    card.appendChild(title);
    card.appendChild(brand);
    card.appendChild(price);
    card.appendChild(link);

    return card;
  }

  /* =============================== */
  /* PRODUCT LIST */
  /* =============================== */

  function renderProducts(container, products) {

    if (
      !products ||
      !products.length
    ) {
      return;
    }

    const grid =
      document.createElement("div");

    grid.className =
      "ai-products";

    products.forEach(function (product) {

      grid.appendChild(
        createProductCard(product)
      );

    });

    container.appendChild(grid);
  }

  /* =============================== */
  /* PRODUCT DETAILS */
  /* =============================== */

  function renderProductDetails(
    container,
    product
  ) {

    if (!product) {
      return;
    }

    const card =
      document.createElement("div");

    card.className =
      "ai-details-card";

    const image =
      document.createElement("img");

    image.className =
      "ai-details-image";

    image.src =
      product.image || "";

    image.alt =
      product.title || "Product";

    const title =
      document.createElement("div");

    title.className =
      "ai-details-title";

    title.textContent =
      product.title || "Product";

    const brand =
      document.createElement("div");

    brand.className =
      "ai-details-brand";

    brand.textContent =
      product.vendor || "";

    const price =
      document.createElement("div");

    price.className =
      "ai-details-price";

    price.textContent =
      "$" + (product.price || "0");

    const meta =
      document.createElement("div");

    meta.className =
      "ai-details-meta";

    if (product.productType) {

      const category =
        document.createElement("span");

      category.className =
        "ai-details-badge";

      category.textContent =
        "📂 " + product.productType;

      meta.appendChild(category);
    }

    const stock =
      document.createElement("div");

    stock.className =
      "ai-details-stock";

    stock.textContent =
      product.availableForSale
        ? "✅ In Stock"
        : "❌ Out of Stock";

    const description =
      document.createElement("div");

    description.className =
      "ai-details-description";

    description.textContent =
      product.description ||
      "Product details are currently unavailable.";

    card.appendChild(image);
    card.appendChild(title);
    card.appendChild(brand);
    card.appendChild(price);
    card.appendChild(meta);
    card.appendChild(stock);
    card.appendChild(description);

    if (product.url) {

      const link =
        document.createElement("a");

      link.href =
        product.url;

      link.target =
        "_blank";

      link.rel =
        "noopener noreferrer";

      link.className =
        "ai-details-button";

      link.textContent =
        "View Product";

      card.appendChild(link);
    }

    container.appendChild(card);
  }

  /* =============================== */
  /* COMPARISON */
  /* =============================== */

  function renderComparison(
    container,
    products
  ) {

    if (
      !products ||
      products.length < 2
    ) {
      return;
    }

    const comparison =
      document.createElement("div");

    comparison.className =
      "ai-comparison";

    products.slice(0, 2).forEach(function (product) {

      const card =
        document.createElement("div");

      card.className =
        "ai-comparison-card";

      const image =
        document.createElement("img");

      image.className =
        "ai-comparison-image";

      image.src =
        product.image || "";

      image.alt =
        product.title || "Product";

      const title =
        document.createElement("div");

      title.className =
        "ai-comparison-title";

      title.textContent =
        product.title || "";

      const brand =
        document.createElement("div");

      brand.className =
        "ai-comparison-brand";

      brand.textContent =
        product.vendor || "";

      const price =
        document.createElement("div");

      price.className =
        "ai-comparison-price";

      price.textContent =
        "$" + (product.price || "0");

      const link =
        document.createElement("a");

      link.href =
        product.url || "#";

      link.target =
        "_blank";

      link.rel =
        "noopener noreferrer";

      link.className =
        "ai-comparison-button";

      link.textContent =
        "View Product";

      card.appendChild(image);
      card.appendChild(title);
      card.appendChild(brand);
      card.appendChild(price);
      card.appendChild(link);

      comparison.appendChild(card);

    });

    container.appendChild(comparison);
  }

  /* =============================== */
  /* BOT RESPONSE */
  /* =============================== */

  function addBotResponse(data) {

    const container =
      document.createElement("div");

    container.className =
      "ai-message bot";

    /* Main reply */

    if (data.reply) {

      const reply =
        document.createElement("div");

      reply.textContent =
        data.reply;

      container.appendChild(reply);

    }

    /* =============================== */
    /* COMPARISON UI */
    /* =============================== */

    if (
      data.messageType === "comparison" &&
      data.products &&
      data.products.length >= 2
    ) {
      renderComparison(
        container,
        data.products
      );
    }

    /* =============================== */
    /* DETAILS UI */
    /* =============================== */

    else if (
      data.messageType === "details" &&
      data.products &&
      data.products.length
    ) {

      renderProductDetails(
        container,
        data.products[0]
      );

    }

    /* =============================== */
    /* NORMAL PRODUCTS */
    /* =============================== */

    else {

      renderProducts(
        container,
        data.products
      );

    }

    /* =============================== */
    /* SUGGESTIONS */
    /* =============================== */

    if (
      data.suggestions &&
      data.suggestions.length
    ) {

      const suggestions =
        document.createElement("div");

      suggestions.className =
        "ai-suggestions";

      data.suggestions.forEach(
        function (suggestion) {

          const button =
            document.createElement("button");

          button.className =
            "ai-suggestion-chip";

          const label =
            typeof suggestion === "string"
              ? suggestion
              : suggestion.label ||
                suggestion.value ||
                "";

          const value =
            typeof suggestion === "string"
              ? suggestion
              : suggestion.value ||
                suggestion.label ||
                "";

          button.textContent =
            label;

          button.addEventListener(
            "click",
            function () {

              sendMessageValue(value);

            }
          );

          suggestions.appendChild(button);

        }
      );

      container.appendChild(
        suggestions
      );
    }

    /* =============================== */
    /* CHECKOUT */
    /* =============================== */

    if (
      data.messageType === "checkout" &&
      data.checkoutUrl
    ) {

      const checkoutButton =
        document.createElement("a");

      checkoutButton.href =
        data.checkoutUrl;

      checkoutButton.target =
        "_blank";

      checkoutButton.rel =
        "noopener noreferrer";

      checkoutButton.className =
        "ai-checkout-button";

      checkoutButton.textContent =
        "🛍️ Proceed to Checkout";

      container.appendChild(
        checkoutButton
      );
    }

    /* =============================== */
    /* SHOW MORE */
    /* =============================== */

    if (data.hasMore) {

      const showMoreButton =
        document.createElement("button");

      showMoreButton.className =
        "ai-show-more-btn";

      showMoreButton.textContent =
        "Show More";

      showMoreButton.addEventListener(
        "click",
        function () {

          sendMessageValue(
            "show more"
          );

        }
      );

      container.appendChild(
        showMoreButton
      );
    }

    messages.appendChild(
      container
    );

    messages.scrollTop =
      messages.scrollHeight;
  }

  /* =============================== */
  /* SEND MESSAGE */
  /* =============================== */

  async function sendMessageValue(text) {

    text =
      text.trim();

    if (!text) {
      return;
    }

    addMessage(
      text,
      "user"
    );

    input.value = "";

    send.disabled = true;

    const loading =
      document.createElement("div");

    loading.className =
      "ai-message bot typing";

    loading.textContent =
      "Searching products...";

    messages.appendChild(
      loading
    );

    messages.scrollTop =
      messages.scrollHeight;

    try {

      const response =
        await fetch(
          API + "/chat",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body: JSON.stringify({
              sessionId:
                sessionId,

              message:
                text
            })
          }
        );

      if (!response.ok) {
        throw new Error(
          "HTTP " +
          response.status
        );
      }

      const data =
        await response.json();

      loading.remove();

      addBotResponse(
        data
      );

    } catch (error) {

      console.error(
        "AI Sales Assistant error:",
        error
      );

      loading.remove();

      addMessage(
        "Sorry, something went wrong. Please try again.",
        "bot"
      );

    } finally {

      send.disabled = false;

      input.focus();
    }
  }

  function sendMessage() {

    sendMessageValue(
      input.value
    );

  }

  send.addEventListener(
    "click",
    sendMessage
  );

  input.addEventListener(
    "keydown",
    function (event) {

      if (
        event.key === "Enter" &&
        !send.disabled
      ) {

        sendMessage();

      }

    }
  );

})();
</script>

{% schema %}
{
  "name": "AI Sales Chatbot",
  "target": "body",
  "settings": []
}
{% endschema %}
