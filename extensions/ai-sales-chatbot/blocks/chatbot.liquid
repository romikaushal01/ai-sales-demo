  const input = document.getElementById("ai-chat-input");
  const send = document.getElementById("ai-chat-send");
  const messages = document.getElementById("ai-chat-messages");

  if (!root || !windowEl || !toggle || !input || !send || !messages) {
    return;
  }

  let sessionId = localStorage.getItem("ai_sales_chat_session");

  if (!sessionId) {
    sessionId = crypto.randomUUID();
    localStorage.setItem("ai_sales_chat_session", sessionId);
  }

  toggle.addEventListener("click", function () {
    windowEl.classList.toggle("open");

    if (windowEl.classList.contains("open")) {
      input.focus();
    }
  });

  function addMessage(text, type) {
    const div = document.createElement("div");
    div.className = "ai-message " + type;
    div.textContent = text;
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function addBotResponse(data) {
    const container = document.createElement("div");
    container.className = "ai-message bot";

    const reply = document.createElement("div");
    reply.textContent = data.reply || "";
    container.appendChild(reply);

    // Products
    if (data.products && data.products.length > 0) {
        const productsGrid = document.createElement("div");
        productsGrid.className = "ai-products";

        data.products.forEach(function (product) {
          const card = document.createElement("div");
          card.className = "ai-product-card";

          card.innerHTML = `
              <img
              src="${product.image || ""}"
              alt="${escapeHtml(product.title || "Product")}"
              />

              <h4>${escapeHtml(product.title || "")}</h4>

              <p class="ai-product-brand">
              ${escapeHtml(product.vendor || "")}
              </p>

              <p class="ai-product-price">
              $${product.price}
              </p>

              <a
              href="${product.url}"
              target="_blank"
              rel="noopener noreferrer"
              class="ai-view-product"
              >
              View Product
              </a>
          `;

          productsGrid.appendChild(card);
        });

        container.appendChild(productsGrid);
    }

    // Suggestions
    if (data.suggestions && data.suggestions.length > 0) {
      const suggestions = document.createElement("div");
      suggestions.className = "ai-suggestions";

      data.suggestions.forEach(function (suggestion) {
        const button = document.createElement("button");

        button.className = "ai-suggestion-chip";

        const label =
          typeof suggestion === "string"
            ? suggestion
            : suggestion.label || suggestion.value || "";

        const value =
          typeof suggestion === "string"
            ? suggestion
            : suggestion.value || suggestion.label || "";

        button.textContent = label;

        button.addEventListener("click", function () {
          sendMessageValue(value);
        });

        suggestions.appendChild(button);
      });

      container.appendChild(suggestions);
    }

    // Checkout
    if (data.messageType === "checkout" && data.checkoutUrl) {
      const checkoutButton = document.createElement("a");

      checkoutButton.href = data.checkoutUrl;
      checkoutButton.target = "_blank";
      checkoutButton.rel = "noopener noreferrer";
      checkoutButton.className = "ai-checkout-button";
      checkoutButton.textContent = "🛍️ Proceed to Checkout";

      container.appendChild(checkoutButton);
    }

    // Show More
    if (data.hasMore) {
      const showMoreButton = document.createElement("button");

      showMoreButton.className = "ai-show-more-btn";
      showMoreButton.textContent = "Show More";

      showMoreButton.addEventListener("click", function () {
        sendMessageValue("show more");
      });

      container.appendChild(showMoreButton);
    }
    messages.appendChild(container);
    messages.scrollTop = messages.scrollHeight;
  }

	function escapeHtml(value) {
		const div = document.createElement("div");
		div.textContent = value;
		return div.innerHTML;
	}

  async function sendMessageValue(text) {
    text = text.trim();

    if (!text) return;

    addMessage(text, "user");
    input.value = "";
    send.disabled = true;

    const loading = document.createElement("div");
    loading.className = "ai-message bot typing";
    loading.textContent = "Searching products...";
    messages.appendChild(loading);

    try {
      const response = await fetch(API + "/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          sessionId: sessionId,
          message: text
        })
      });

      const data = await response.json();

      loading.remove();

      addBotResponse(data);

    } catch (error) {
      console.error("AI Sales Assistant error:", error);

      loading.remove();

      addMessage(
        "Sorry, something went wrong. Please try again.",
        "bot"
      );
    } finally {
      send.disabled = false;
      input.focus();
    }
  }

  function sendMessage() {
    sendMessageValue(input.value);
  }

  send.addEventListener("click", sendMessage);

  input.addEventListener("keydown", function (event) {
    if (event.key === "Enter" && !send.disabled) {
      sendMessage();
    }
  });

})();
</script>

